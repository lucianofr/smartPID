  "cards": [
    { "dot": "amber", "title": "O que o bloco colapsado escondia", "items": [
      "São 8 workers, não 5: faltavam TrendBufferWorker, SystemEventWorker e ExportWorker",
      "Duas classes distintas: por malha (N instâncias) e singleton do daemon (1 instância)",
      "SystemEventWorker não tem thread — é fachada que publica na thread de quem chama emit()",
      "ExportWorker não é worker de barramento: sem thread e sem assinatura, roda sob REST"
    ] },
    { "dot": "cyan", "title": "Por malha — LoopManager", "items": [
      "LoopContext guarda pid_worker, stats_worker, ai_worker e monitor_worker por controlador",
      "Todos os tópicos levam sufixo .{id}; start_loop/stop_loop controla o ciclo de vida",
      "StatsWorker: janela de 5×tss, publica STATS a cada ~5 s de processo",
      "AIWorker: ciclo de 3×tss; o retune completo vai ao TuningStore, nunca ao barramento"
    ] },
    { "dot": "violet", "title": "Singleton — assinatura por prefixo", "items": [
      "DBWorker assina os prefixos TELEMETRY e LOG.AI. — lote de 500, flush a cada 5 s",
      "TrendBufferWorker mantém o ring de 1 h em memória que semeia o gráfico do /trend",
      "AlarmWorker assina o prefixo STATUS. e publica EVENT.ALARM.{cid}",
      "Cada um roda numa única thread daemon e atende todas as malhas do projeto"
    ] },
    { "dot": "emerald", "title": "Escritores do .spid", "items": [
      "DBWorker: historian, com engine SQLAlchemy próprio criado na thread do worker",
      "AlarmWorker: alarm_repo, agendado no loop principal via call_soon_threadsafe",
      "SystemEventWorker: system_event_repo, pelo mesmo mecanismo",
      "ExportWorker: só leitura — consulta o historian para gerar CSV/JSON"
    ] }
  ]
