# Python
__pycache__/
*.pyc
*.pyo
.venv/
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/

# Environment
.env

# Project files (user data, not committed)
*.spid
# ...and the WAL sidecars SQLite recreates every time the daemon runs.
*.spid-wal
*.spid-shm

# Backend-managed project DBs carry their sidecars WITHOUT the .spid suffix
# (projects/elkem -> projects/elkem-wal), so the patterns above never matched
# them and every daemon run left two binaries in `git status`.
/projects/*-wal
/projects/*-shm

# RL state the AI worker checkpoints next to the project file. Runtime state,
# not source. Anchored: `models/` alone would also swallow the domain's own
# packages/smart_pid_domain/src/smart_pid_domain/models/ package.
/models/

# Superpowers brainstorm sessions
.superpowers/

# Claude local settings (personal, not committed)
.claude/settings.local.json
# Session scratch snapshot: rewritten every run and a recurring merge conflict.
.claude/docs/estado-atual.md

# OS
.DS_Store
Thumbs.db

# Coverage
htmlcov/
.coverage
.worktrees/

# Web HMI (smart_pid_web)
packages/smart_pid_web/node_modules/
packages/smart_pid_web/dist/

# SDD process artifacts (not deliverables)
/.sdd/

# Local tool/test scratch state (not project deliverables)
/.tokensave/
/exports/
/testsprite_tests/
/graphify-out/
/.serena/

testsprite_tests/tmp/config.json

# Windows installers
/dist/windows/
