# Smart PID Core Engine — environment configuration
#
# Copy to `.env` at the repository root and fill in the values. Both the daemon
# (pydantic-settings, `SPID_` prefix) and the web dev server read this file:
# `packages/smart_pid_web/vite.config.ts` resolves its `/api` and `/ws` proxy
# target from SPID_API_HOST/SPID_API_PORT, so the two can no longer drift apart.

# REQUIRED. Signing key for the auth tokens — generate a fresh one per
# deployment and never commit the real value:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SPID_JWT_SECRET=replace-me-with-a-generated-secret

SPID_LOG_LEVEL=INFO
SPID_OPCUA_ENDPOINT=opc.tcp://localhost:4848

# Loopback by default (TD-004). Bind 0.0.0.0 only as a deliberate, reviewed act:
# the API has no transport-level protection of its own.
SPID_API_HOST=127.0.0.1
SPID_API_PORT=8000

# Reverse proxies whose `X-Forwarded-For` may be believed (JSON array of
# addresses or CIDRs). Leave unset when the daemon is reached directly: the
# header is caller-supplied text then, and honouring it would let the login
# throttle be spoofed away and fake addresses reach the access log. Set it
# behind a proxy that is the ONLY ingress, or every session and log row reads
# as the proxy's own address instead of the operator's.
# SPID_TRUSTED_PROXIES=["10.0.0.0/8"]

SPID_ZMQ_PUBLISH_PORT=5555
SPID_SIMULATOR_ENABLED=true
SPID_SIMULATOR_PORT=4849

# Optimizer steady-state guardrail, in percent of SP. While |PV - SP| stays
# inside this band the online tuner skips the loop instead of moving Ki/Ti.
# Overridden per loop by the controller's own `stability_band_pct`.
SPID_STABILITY_BAND_PCT=2.0
